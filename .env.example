# Copy to .env for local development. Never commit real values.
# All IDs may be left empty: local dev then uses Google's official test ads
# on native and shows no ads on the web.

# --- AdMob app IDs (read by app.config.ts at build time, not bundled) ---
# Required for production EAS builds of that platform (the build fails
# without it). Also used to write app-ads.txt in the web build.
# Format: ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=

# --- AdMob banner unit IDs (bundled into the app) ---
# Format: ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
# Required for production EAS builds of that platform (the build fails
# without it). Dev / preview builds always use Google's test banner IDs.
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=

# --- AdSense (web only) ---
# Format: ca-pub-XXXXXXXXXXXXXXXX
EXPO_PUBLIC_ADSENSE_CLIENT_ID=
# Responsive display ad unit slot IDs (digits only)
EXPO_PUBLIC_ADSENSE_SETUP_SLOT_ID=
EXPO_PUBLIC_ADSENSE_RESULT_SLOT_ID=
