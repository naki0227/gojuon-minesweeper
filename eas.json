{
  "cli": {
    "version": ">= 24.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_ENV": "production"
      },
      "ios": {
        "env": { "APP_TARGET_PLATFORM": "ios" }
      },
      "android": {
        "env": { "APP_TARGET_PLATFORM": "android" }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
